{
    "name": "settermjd/inbound-call-with-text-resposne",
    "description": "This project shows how to respond to an inbound voice call via SMS.",
    "minimum-stability": "stable",
    "support": {
        "docs": "https://github.com/settermjd/inbound-call-with-text-response/README.md",
        "issues": "https://github.com/settermjd/inbound-call-with-text-response/issues"
    },
    "keywords": [
        "PHP",
        "PSR7",
        "Slim Framework",
        "Slim",
        "Twilio Programmable Messaging",
        "Twilio Programmable Voice",
        "Twilio"
    ],
    "require": {
        "monolog/monolog": "^3.10",
        "php-di/slim-bridge": "^3.4",
        "slim/psr7": "^1.8",
        "slim/slim": "^4.15",
        "twilio/sdk": "^8.10",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "codeception/codeception": "^5.3",
        "codeception/lib-asserts": "^3.2",
        "codeception/module-rest": "^3.4",
        "friendsofphp/php-cs-fixer": "^3.93",
        "laminas/laminas-coding-standard": "^3.1",
        "laminas/laminas-component-installer": "^3.7",
        "laminas/laminas-diactoros": "^3.8",
        "phpstan/phpdoc-parser": "^2.3",
        "codeception/module-phpbrowser": "*",
        "codeception/module-asserts": "*"
    },
    "config": {
        "allow-plugins": {
            "laminas/laminas-component-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AppTest\\": "test/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@static-analysis",
            "@test"
        ],
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "post-create-project-cmd": [
            "cp -v .env.example .env"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "php -S 0.0.0.0:8080 -t public"
        ],
        "static-analysis": "vendor/bin/phpstan analyse",
        "test": "codecept run --steps"
    }
}
